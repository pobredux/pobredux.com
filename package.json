    "sharp": "^0.35.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "takumi-js": "^2.13.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
